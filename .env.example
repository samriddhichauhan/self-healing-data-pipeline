# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to '.env' and adjust if needed. Every value below has a
# working default in docker-compose.yml — this file only needs to exist for
# local overrides.
# ==============================================================================

# --- Airflow Core Orchestrator Config ---
# For Linux/macOS, set to your system UID: AIRFLOW_UID=$(id -u)
# For Windows/WSL Docker Desktop, 50000 is the default.
AIRFLOW_UID=50000
AIRFLOW_GID=0

# --- Local AI Diagnostic Adapter (Ollama) ---
# Optional. If unreachable, the pipeline automatically falls back to a
# deterministic rule-based diagnostic engine — no external paid API is ever
# used anywhere in this project.
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:latest

# --- Pipeline Postgres database (separate from Airflow's own metadata DB) ---
# These match docker-compose.yml defaults; only needed to override for a
# non-Docker/host run (e.g. pytest, demo scripts).
PIPELINE_DB_HOST=localhost
PIPELINE_DB_PORT=5432
PIPELINE_DB_NAME=pipeline
PIPELINE_DB_USER=airflow
PIPELINE_DB_PASSWORD=airflow

# --- App Backend & Frontend ---
BACKEND_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
