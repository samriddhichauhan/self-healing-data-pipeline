# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to '.env' and fill in your actual values.
# NEVER commit the '.env' file with real credentials to version control.
# ==============================================================================

# --- Airflow Core Orchestrator Config ---
# For Linux/macOS, set to your system UID: AIRFLOW_UID=$(id -u)
# For Windows/WSL Docker Desktop, 50000 is the default.
AIRFLOW_UID=50000
AIRFLOW_GID=0

# --- Google Cloud Platform (GCP) Configuration ---
# Optional: Set when live BigQuery integration credentials are added
GCP_PROJECT_ID=your-gcp-project-id
GCP_DATASET_ID=pipeline_intern_yourname
GCP_LOCATION=US
GOOGLE_APPLICATION_CREDENTIALS=/opt/airflow/config/gcp-service-account.json

# --- AI Agent Configuration ---
# Optional: Set for LLM-assisted diagnostic reasoning (automatically falls back to rule-based engine if omitted)
AGENT_MODEL_NAME=gemini-1.5-flash
GEMINI_API_KEY=your_gemini_api_key_here

# --- App Backend & Frontend API Config ---
PORT=8000
NODE_ENV=development
BACKEND_API_URL=http://localhost:8000
